# ===== ZeroDay's LLM Rakshak environment =====  (copy to .env; NEVER commit real values)
LLMGUARD_ENV=production
# MongoDB Atlas connection string (mandatory primary database). Use a dedicated DB user; see docs/DEPLOYMENT.md for least-privilege roles.
LLMGUARD_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
LLMGUARD_MONGODB_DB=llmguard
LLMGUARD_REDIS_URL=redis://redis:6379/0
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
LLMGUARD_JWT_SECRET=
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, keep the old key after a comma until all credentials are re-encrypted.
LLMGUARD_ENCRYPTION_KEYS=
LLMGUARD_FRONTEND_ORIGIN=https://zeroday.example.com
LLMGUARD_COOKIE_SECURE=true
LLMGUARD_TRUST_PROXY=true            # only behind the bundled nginx (it overwrites X-Forwarded-For)
LLMGUARD_TASK_BACKEND=celery
# SSRF policy for user-supplied endpoints. Keep false for SaaS; true only for self-hosted/private deployments.
LLMGUARD_ALLOW_PRIVATE_TARGETS=false
LLMGUARD_ALLOW_HTTP_TARGETS=false
# Optional process-wide pacing between calls to a hosted provider, in seconds.
# Set to 60 / the provider's requests-per-minute quota (e.g. 4.2 for 15 RPM).
LLMGUARD_PROVIDER_MIN_INTERVAL=0
# Optional SMTP (email verification, reset, invitations). Without it, emails are NOT delivered.
LLMGUARD_SMTP_HOST=
LLMGUARD_SMTP_PORT=587
LLMGUARD_SMTP_USER=
LLMGUARD_SMTP_PASSWORD=
LLMGUARD_SMTP_FROM=ZeroDay's LLM Rakshak <no-reply@zeroday.example.com>
# Optional platform-managed Anthropic key for AI analysis (users may use their own BYOK key instead).
LLMGUARD_ANALYSIS_API_KEY=
LLMGUARD_ANALYSIS_MODEL=claude-sonnet-5-5
# Payments (disabled by default). Entitlements change only through verified webhooks or admin action.
LLMGUARD_PAYMENTS_ENABLED=false
LLMGUARD_STRIPE_WEBHOOK_SECRET=
LLMGUARD_RAZORPAY_WEBHOOK_SECRET=
